<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>GoPress.org — Ideas y conocimiento de la comunidad</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Ideas, guías y experiencias escritas por la comunidad de GoPress.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/basic.css?v=9">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">{{ .headTrailCode }}
</head>
<body>
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    <div class="site-wrapper">
        <header class="site-header">
            <nav class="top-bar container" aria-label="Navegación principal">
                <a class="brand" href="/">GoPress<span>.org</span></a>
                <div class="auth-actions">
                    <div id="login"><a href="/auth/login">Iniciar sesión</a></div>
                    <div id="logout" hidden>
                        <img id="user_picture" class="nav-avatar" alt="" hidden>
                        <span id="user_nick"></span>
                        <a href="/blogs">Blogs</a>
                        <a href="/bookmarks">Guardados</a>
                        <a href="/admin/">Administración</a>
                        <a href="/auth/logout">Salir</a>
                    </div>
                </div>
            </nav>
            <div class="hero content-column">
                <span class="eyebrow">Publicaciones independientes</span>
                <h1>Ideas escritas para ser útiles.</h1>
                <p>Experiencias, referencias y aprendizajes compartidos sin ruido.</p>
            </div>
        </header>

        <main class="site-main" id="main-content">
            <section class="content-column" aria-labelledby="latest-title">
                <header class="section-header">
                    <h2 id="latest-title">Últimas publicaciones</h2>
                </header>
                {{ if .articles }}
                <div class="article-feed">
                    {{ range $i, $article := .articles }}
                    <article class="article-card" itemscope itemtype="https://schema.org/Article">
                        <h3 itemprop="headline">
                            <a href="/blog/{{ .BlogSlug }}/article/{{ .Url }}" itemprop="url">{{ .Title }}</a>
                        </h3>
                        <div class="card-excerpt" itemprop="description">{{ .ContentSummary }}</div>
                        <div class="article-meta">
                            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                                Por <span itemprop="name">{{ .AuthorNick }}</span>
                            </span>
                            <time datetime="{{ .PublishOn.Format "2006-01-02" }}" itemprop="datePublished">{{ .PublishOn.Format "02/01/2006" }}</time>
                            <span>{{ .Stats.Views }} lecturas</span>
                        </div>
                        {{ if .Tags }}
                        <div class="card-tags" aria-label="Etiquetas del artículo">
                            {{ range $j, $tag := .Tags }}
                            <a class="tag" href="/tag/{{ $tag }}">#{{ $tag }}</a>
                            {{ end }}
                        </div>
                        {{ end }}
                    </article>
                    {{ end }}
                </div>
                {{ else }}
                <div class="empty-state">
                    <h2>Aún no hay publicaciones.</h2>
                    <p>La primera historia aparecerá aquí cuando esté lista.</p>
                </div>
                {{ end }}
            </section>
        </main>

        <footer class="site-footer">
            <div class="footer-content container">
                <p>GoPress es software libre construido por la comunidad.</p>
                <nav class="footer-links" aria-label="Enlaces del proyecto">
                    <a href="https://github.com/fulldump/gopress">GitHub</a>
                    <a href="https://www.twitch.tv/fulldump">Twitch</a>
                    <a href="https://www.youtube.com/@fulldump">YouTube</a>
                </nav>
            </div>
        </footer>
    </div>
    <script src="/public.js?v=5" defer></script>
</body>
</html>
