<!DOCTYPE html>
<html lang="{{ .locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ t .locale "saved.title" }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ t .locale "saved.description" }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/basic.css?v=11">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="manifest" href="/site.webmanifest">{{ .headTrailCode }}
</head>
<body>
    <a class="skip-link" href="#main-content">{{ t .locale "nav.skip" }}</a>
    <div class="site-wrapper">
        <header class="site-header">
            <nav class="top-bar container" aria-label="{{ t .locale "nav.main" }}">
                <a class="brand" href="/">GoPress<span>.org</span></a>
                <div class="auth-actions">
                    <nav class="locale-switcher"><a href="?lang=es">ES</a><a href="?lang=en">EN</a><a href="?lang=zh">ZH</a></nav><div id="login"><a href="/auth/login">{{ t .locale "nav.sign_in" }}</a></div>
                    <div id="logout" hidden><img id="user_picture" class="nav-avatar" alt="" hidden><span id="user_nick"></span><a href="/blogs">{{ t .locale "nav.blogs" }}</a><a href="/bookmarks" aria-current="page">{{ t .locale "nav.saved" }}</a><a href="/admin/">{{ t .locale "nav.admin" }}</a><a href="/auth/logout">{{ t .locale "nav.sign_out" }}</a></div>
                </div>
            </nav>
            <div class="page-intro content-column"><span class="eyebrow">{{ t .locale "saved.eyebrow" }}</span><h1>{{ t .locale "saved.heading" }}</h1><p>{{ t .locale "saved.intro" }}</p></div>
        </header>
        <main class="site-main saved-page" id="main-content">
            <section class="content-column saved-section" data-saved-section data-kind="articles" aria-labelledby="saved-articles-title"><header class="section-header"><h2 id="saved-articles-title">{{ t .locale "saved.articles" }}</h2></header><div class="saved-status" data-saved-status role="status" aria-live="polite">{{ t .locale "common.loading" }}</div><div class="saved-list article-feed" data-saved-list></div><button class="load-more-button" data-saved-more type="button" hidden>{{ t .locale "pagination.load_more" }}</button></section>
            <section class="content-column saved-section" data-saved-section data-kind="blogs" aria-labelledby="saved-blogs-title"><header class="section-header"><h2 id="saved-blogs-title">{{ t .locale "saved.blogs" }}</h2></header><div class="saved-status" data-saved-status role="status" aria-live="polite">{{ t .locale "common.loading" }}</div><div class="saved-list article-feed" data-saved-list></div><button class="load-more-button" data-saved-more type="button" hidden>{{ t .locale "pagination.load_more" }}</button></section>
            <section class="content-column saved-section" data-saved-section data-kind="comments" aria-labelledby="saved-comments-title"><header class="section-header"><h2 id="saved-comments-title">{{ t .locale "saved.comments" }}</h2></header><div class="saved-status" data-saved-status role="status" aria-live="polite">{{ t .locale "common.loading" }}</div><div class="saved-list article-feed" data-saved-list></div><button class="load-more-button" data-saved-more type="button" hidden>{{ t .locale "pagination.load_more" }}</button></section>
            <section class="content-column saved-section" data-saved-section data-kind="own-comments" aria-labelledby="own-comments-title"><header class="section-header"><h2 id="own-comments-title">{{ t .locale "saved.own_comments" }}</h2></header><div class="saved-status" data-saved-status role="status" aria-live="polite">{{ t .locale "common.loading" }}</div><div class="saved-list article-feed" data-saved-list></div><button class="load-more-button" data-saved-more type="button" hidden>{{ t .locale "pagination.load_more" }}</button></section>
        </main>
        <footer class="site-footer"><div class="footer-content container"><p>{{ t .locale "footer.text" }}</p></div></footer>
    </div>
    <script id="gopress-i18n" type="application/json">{{ json .messages }}</script><script src="/public.js?v=9" defer></script><script src="/bookmarks.js?v=4" defer></script>
</body>
</html>
