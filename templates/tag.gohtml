<!DOCTYPE html>
<html lang="{{ .locale }}">
<head>
    <meta charset="utf-8">
    <title>#{{ .tag }} — GoPress</title>
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Artículos publicados con la etiqueta {{ .tag }} en GoPress.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/basic.css?v=11">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">{{ .headTrailCode }}
</head>
<body>
    <a class="skip-link" href="#main-content">{{ t .locale "nav.skip" }}</a>
    <div class="site-wrapper">
        <header class="site-header">
            <nav class="top-bar container" aria-label="{{ t .locale "nav.main" }}">
                <a class="brand" href="/">GoPress<span>.org</span></a>
                <div class="auth-actions">
                    <nav class="locale-switcher"><a href="?lang=es">ES</a><a href="?lang=en">EN</a><a href="?lang=zh">ZH</a></nav><div id="login"><a href="/auth/login">{{ t .locale "nav.sign_in" }}</a></div>
                    <div id="logout" hidden>
                        <img id="user_picture" class="nav-avatar" alt="" hidden>
                        <span id="user_nick"></span>
                        <a href="/blogs">{{ t .locale "nav.blogs" }}</a><a href="/bookmarks">{{ t .locale "nav.saved" }}</a><a href="/admin/">{{ t .locale "nav.admin" }}</a><a href="/auth/logout">{{ t .locale "nav.sign_out" }}</a>
                    </div>
                </div>
            </nav>
            <div class="page-intro content-column">
                <span class="eyebrow">{{ t .locale "tag.eyebrow" }}</span>
                <h1>#{{ .tag }}</h1>
                <p>{{ t .locale "tag.intro" }}</p>
            </div>
        </header>

        <main class="site-main" id="main-content">
            <section class="content-column" aria-label="Artículos etiquetados como {{ .tag }}">
                {{ if .articles }}
                <div class="article-feed pagination-list" data-pagination-list>
                    {{ range $i, $article := .articles }}
                    <article class="article-card pagination-item" data-pagination-item data-item-id="{{ .Id }}" itemscope itemtype="https://schema.org/Article">
                        <h2 itemprop="headline">
                            <a href="{{ .PublicUrl }}" itemprop="url">{{ .Title }}</a>
                        </h2>
                        <div class="card-excerpt" itemprop="description">{{ .ContentSummary }}</div>
                        <div class="article-meta">
                            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                                {{ t $.locale "article.by" }} <span itemprop="name">{{ .AuthorNick }}</span>
                            </span>
                            <time datetime="{{ .PublishOn.Format "2006-01-02" }}" itemprop="datePublished">{{ .PublishOn.Format "02/01/2006" }}</time>
                            <span>{{ .Stats.Views }} {{ t $.locale "article.reads" }}</span>
                        </div>
                        {{ if .Tags }}
                        <div class="card-tags" aria-label="Etiquetas del artículo">
                            {{ range $j, $tag := .Tags }}
                            <a class="tag" href="/tag/{{ $tag }}">#{{ $tag }}</a>
                            {{ end }}
                        </div>
                        {{ end }}
                        <nav class="language-links">{{ range .AvailableLanguages }}<a href="{{ .Url }}">{{ .Language }}</a>{{ end }}</nav>
                    </article>
                    {{ end }}
                </div>
                {{ if .nextURL }}<div class="pagination-control" data-pagination-control><a class="load-more-button" data-load-more href="{{ .nextURL }}">{{ t .locale "pagination.load_more" }}</a><span class="pagination-status" data-pagination-status role="status" aria-live="polite"></span></div>{{ end }}
                {{ else }}
                <div class="empty-state"><h2>{{ t .locale "tag.empty" }}</h2></div>
                {{ end }}
            </section>
        </main>

        <footer class="site-footer">
            <div class="footer-content container">
                <p>{{ t .locale "footer.text" }}</p><nav class="footer-links" aria-label="{{ t .locale "footer.links" }}">
                    <a href="https://github.com/fulldump/gopress">GitHub</a>
                    <a href="https://www.twitch.tv/fulldump">Twitch</a>
                    <a href="https://www.youtube.com/@fulldump">YouTube</a>
                </nav>
            </div>
        </footer>
    </div>
    <script id="gopress-i18n" type="application/json">{{ json .messages }}</script><script src="/public.js?v=8" defer></script>
</body>
</html>
