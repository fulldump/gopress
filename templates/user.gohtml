<!DOCTYPE html>
<html lang="{{ .locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ .userNick }} — GoPress</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Artículos escritos por {{ .userNick }} en GoPress.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/basic.css?v=11">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">{{ .headTrailCode }}
</head>
<body>
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    <div class="site-wrapper">
        <header class="site-header">
            <nav class="top-bar container" aria-label="Navegación principal">
                <a class="brand" href="/">GoPress<span>.org</span></a>
                <div class="auth-actions">
                    <div id="login"><a href="/auth/login">Iniciar sesión</a></div>
                    <div id="logout" hidden>
                        <img id="user_picture" class="nav-avatar" alt="" hidden>
                        <span id="user_nick"></span>
                        <a href="/bookmarks">Guardados</a>
                        <a href="/admin/">Administración</a>
                        <a href="/auth/logout">Salir</a>
                    </div>
                </div>
            </nav>
            <div class="page-intro content-column">
                <span class="eyebrow">Autor</span>
                <h1>@{{ .userNick }}</h1>
                {{ if .tag }}
                <p>Publicaciones de este autor sobre <a href="/tag/{{ .tag }}">#{{ .tag }}</a>.</p>
                {{ else }}
                <p>Artículos, notas y experiencias compartidas por {{ .userNick }}.</p>
                {{ end }}
            </div>
        </header>

        <main class="site-main" id="main-content">
            <section class="content-column" aria-label="Publicaciones de {{ .userNick }}">
                {{ if .articles }}
                <div class="article-feed">
                    {{ range $i, $article := .articles }}
                    <article class="article-card" itemscope itemtype="https://schema.org/Article">
                        <span itemprop="author" itemscope itemtype="https://schema.org/Person" hidden><meta itemprop="name" content="{{ .AuthorNick }}"></span>
                        <h2 itemprop="headline">
                            <a href="/user/{{ .AuthorNick }}/article/{{ .Url }}" itemprop="url">{{ .Title }}</a>
                        </h2>
                        <div class="card-excerpt" itemprop="description">{{ .ContentSummary }}</div>
                        <div class="article-meta">
                            <time datetime="{{ .PublishOn.Format "2006-01-02" }}" itemprop="datePublished">{{ .PublishOn.Format "02/01/2006" }}</time>
                            <span>{{ .Stats.Views }} lecturas</span>
                        </div>
                        {{ if .Tags }}
                        <div class="card-tags" aria-label="Etiquetas del artículo">
                            {{ range $j, $tag := .Tags }}
                            <a class="tag" href="/user/{{ $article.AuthorNick }}/tag/{{ $tag }}">#{{ $tag }}</a>
                            {{ end }}
                        </div>
                        {{ end }}
                    </article>
                    {{ end }}
                </div>
                {{ else }}
                <div class="empty-state"><h2>Este autor aún no ha publicado.</h2></div>
                {{ end }}
            </section>
        </main>

        <footer class="site-footer">
            <div class="footer-content container">
                <p>GoPress es software libre construido por la comunidad.</p>
                <nav class="footer-links" aria-label="Enlaces del proyecto">
                    <a href="https://github.com/fulldump/gopress">GitHub</a>
                    <a href="https://www.twitch.tv/fulldump">Twitch</a>
                    <a href="https://www.youtube.com/@fulldump">YouTube</a>
                </nav>
            </div>
        </footer>
    </div>
    <script id="gopress-i18n" type="application/json">{{ json .messages }}</script><script src="/public.js?v=7" defer></script>
</body>
</html>
