<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>{{ .article.Title }} — GoPress</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ .og_description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/basic.css?v=6">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta property="og:title" content="{{ .og_title }}">
    <meta property="og:url" content="{{ .og_url }}">
    <meta property="og:image" content="{{ .og_image }}">
    <meta property="og:site_name" content="GoPress, blogs para todos">
    <meta property="og:description" content="{{ .og_description }}">
    <meta name="twitter:card" content="summary">{{ .headTrailCode }}
</head>
<body>
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    <div class="site-wrapper">
        <header class="site-header">
            <nav class="top-bar container" aria-label="Navegación principal">
                <a class="brand" href="/">GoPress<span>.org</span></a>
                <div class="auth-actions">
                    <div id="login"><a href="/auth/login">Iniciar sesión</a></div>
                    <div id="logout" hidden>
                        <img id="user_picture" class="nav-avatar" alt="" hidden>
                        <span id="user_nick"></span>
                        <a href="/admin/">Administración</a>
                        <a href="/auth/logout">Salir</a>
                    </div>
                </div>
            </nav>
        </header>

        <main class="site-main" id="main-content">
            <div class="container">
                <article class="post" itemscope itemtype="https://schema.org/Article">
                    <header class="post-header">
                        <h1 class="post-title" itemprop="headline">{{ .article.Title }}</h1>
                        <div class="post-meta">
                            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                                Por <a href="/user/{{ .article.AuthorNick }}" itemprop="url"><span itemprop="name">{{ .article.AuthorNick }}</span></a>
                            </span>
                            <time datetime="{{ .article.PublishOn.Format "2006-01-02" }}" itemprop="datePublished">{{ .article.PublishOn.Format "02/01/2006" }}</time>
                            <span>{{ .article.Stats.Views }} lecturas</span>
                        </div>
                        {{ if .article.Tags }}
                        <div class="post-tags" aria-label="Etiquetas del artículo">
                            {{ range $j, $tag := .article.Tags }}
                            <a class="tag" href="/tag/{{ $tag }}" itemprop="about">#{{ $tag }}</a>
                            {{ end }}
                        </div>
                        {{ end }}
                    </header>
                    <div class="post-content" itemprop="articleBody">{{ .article.ContentHTML }}</div>
                </article>

                <section class="comments-section" id="comments" data-endpoint="/v1/articles/{{ .article.Id }}/comments" aria-labelledby="comments-title">
                    <div class="comments-heading">
                        <h2 id="comments-title">Comentarios <span id="comments-count"></span></h2>
                    </div>

                    <form class="comment-form" id="comment-form">
                        <div class="comment-fields">
                            <label>
                                Nombre
                                <input type="text" name="name" maxlength="100" autocomplete="name" required>
                            </label>
                            <label>
                                Email <small>Opcional, nunca se publica</small>
                                <input type="email" name="email" maxlength="254" autocomplete="email">
                            </label>
                        </div>
                        <label>
                            Comentario
                            <textarea name="text" rows="5" maxlength="10000" aria-describedby="comment-markdown-help" required></textarea>
                        </label>
                        <div class="comment-form-footer">
                            <span id="comment-markdown-help">Admite Markdown y bloques de código.</span>
                            <button type="submit">Publicar</button>
                        </div>
                        <p class="comment-form-message" role="alert"></p>
                    </form>

                    <div id="comments-status" class="comments-status" role="status" aria-live="polite">Cargando comentarios...</div>
                    <div id="comments-list" class="comments-list"></div>
                </section>
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content container">
                <p>GoPress es software libre construido por la comunidad.</p>
                <nav class="footer-links" aria-label="Enlaces del proyecto">
                    <a href="https://github.com/fulldump/gopress">GitHub</a>
                    <a href="https://www.twitch.tv/fulldump">Twitch</a>
                    <a href="https://www.youtube.com/@fulldump">YouTube</a>
                </nav>
            </div>
        </footer>
    </div>
    <script src="/comments.js?v=2" defer></script>
    <script src="/public.js?v=1" defer></script>
</body>
</html>
