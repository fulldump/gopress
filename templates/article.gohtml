<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>{{ .article.Title }} — GoPress</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ .og_description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/basic.css?v=7">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta property="og:title" content="{{ .og_title }}">
    <meta property="og:url" content="{{ .og_url }}">
    <meta property="og:image" content="{{ .og_image }}">
    <meta property="og:site_name" content="GoPress, blogs para todos">
    <meta property="og:description" content="{{ .og_description }}">
    <meta name="twitter:card" content="summary">{{ .headTrailCode }}
</head>
<body>
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    <div class="site-wrapper">
        <header class="site-header">
            <nav class="top-bar container" aria-label="Navegación principal">
                <a class="brand" href="/">GoPress<span>.org</span></a>
                <div class="auth-actions">
                    <div id="login"><a href="/auth/login">Iniciar sesión</a></div>
                    <div id="logout" hidden>
                        <img id="user_picture" class="nav-avatar" alt="" hidden>
                        <span id="user_nick"></span>
                        <a href="/bookmarks">Guardados</a>
                        <a href="/admin/">Administración</a>
                        <a href="/auth/logout">Salir</a>
                    </div>
                </div>
            </nav>
        </header>

        <main class="site-main" id="main-content">
            <div class="container">
                <article class="post" itemscope itemtype="https://schema.org/Article">
                    <header class="post-header">
                        <h1 class="post-title" itemprop="headline">{{ .article.Title }}</h1>
                        <div class="post-meta">
                            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                                Por <a href="/user/{{ .article.AuthorNick }}" itemprop="url"><span itemprop="name">{{ .article.AuthorNick }}</span></a>
                            </span>
                            <time datetime="{{ .article.PublishOn.Format "2006-01-02" }}" itemprop="datePublished">{{ .article.PublishOn.Format "02/01/2006" }}</time>
                            <span>{{ .article.Stats.Views }} lecturas</span>
                        </div>
                        {{ if .article.Tags }}
                        <div class="post-tags" aria-label="Etiquetas del artículo">
                            {{ range $j, $tag := .article.Tags }}
                            <a class="tag" href="/tag/{{ $tag }}" itemprop="about">#{{ $tag }}</a>
                            {{ end }}
                        </div>
                        {{ end }}
                    </header>
                    <div class="post-content" itemprop="articleBody">{{ .article.ContentHTML }}</div>
                    <footer class="article-feedback" id="feedback" data-endpoint="/v1/articles/{{ .article.Id }}" data-title="{{ .article.Title }}">
                        <div class="feedback-actions" aria-label="Acciones del artículo">
                            <button class="feedback-button" id="article-like" type="button" aria-pressed="false" disabled>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.4 20.2 3 15.8a3.4 3.4 0 0 1 4.8-4.8l.7.7V5.5a1.5 1.5 0 0 1 3 0v4.1-6a1.5 1.5 0 0 1 3 0v.8-5.3a1.5 1.5 0 0 1 3 0v1-4.1a1.5 1.5 0 0 1 3 0v6.8c0 2-.8 3.8-2.2 5.2l-2.2 2.2H7.4Z"/></svg>
                                <span>Aplaudir</span>
                                <span class="feedback-count" id="article-like-count">0</span>
                            </button>
                            <button class="feedback-button" id="article-bookmark" type="button" aria-pressed="false" disabled>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h11v17L12 17l-5.5 3.5v-17Z"/></svg>
                                <span>Guardar</span>
                            </button>
                            <button class="feedback-button" id="article-share" type="button" aria-haspopup="dialog" aria-controls="share-dialog">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"/></svg>
                                <span>Compartir</span>
                            </button>
                        </div>
                        <p class="feedback-status" id="feedback-status" role="status" aria-live="polite"></p>
                    </footer>
                </article>

                <dialog class="share-dialog" id="share-dialog" aria-labelledby="share-dialog-title">
                    <div class="share-dialog-header">
                        <div>
                            <span class="eyebrow">Haz que circule</span>
                            <h2 id="share-dialog-title">Compartir artículo</h2>
                        </div>
                        <form method="dialog">
                            <button class="share-dialog-close" type="submit" aria-label="Cerrar modal">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                            </button>
                        </form>
                    </div>
                    <div class="share-options">
                        <button class="share-option" type="button" data-share="copy"><span class="share-option-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="1"/><path d="M16 8V5H5v11h3"/></svg></span><span>Copiar enlace</span></button>
                        <button class="share-option" type="button" data-share="bluesky"><span class="share-option-icon">BS</span><span>Bluesky</span></button>
                        <button class="share-option" type="button" data-share="threads"><span class="share-option-icon">@</span><span>Threads</span></button>
                        <button class="share-option" type="button" data-share="linkedin"><span class="share-option-icon">in</span><span>LinkedIn</span></button>
                        <button class="share-option" type="button" data-share="x"><span class="share-option-icon">X</span><span>X</span></button>
                        <button class="share-option" type="button" data-share="facebook"><span class="share-option-icon">f</span><span>Facebook</span></button>
                        <button class="share-option" type="button" data-share="instagram"><span class="share-option-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.2" cy="6.8" r=".8"/></svg></span><span>Instagram</span></button>
                        <button class="share-option" type="button" data-share="youtube"><span class="share-option-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 8 6.5 4-6.5 4V8Z"/></svg></span><span>YouTube</span></button>
                        <button class="share-option" type="button" data-share="whatsapp"><span class="share-option-icon">WA</span><span>WhatsApp</span></button>
                        <button class="share-option" type="button" data-share="email"><span class="share-option-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17v-11Zm.5.5 8 6 8-6"/></svg></span><span>Email</span></button>
                    </div>
                    <p class="share-dialog-status" id="share-dialog-status" role="status" aria-live="polite"></p>
                </dialog>

                <section class="comments-section" id="comments" data-endpoint="/v1/articles/{{ .article.Id }}/comments" aria-labelledby="comments-title">
                    <div class="comments-heading">
                        <h2 id="comments-title">Comentarios <span id="comments-count"></span></h2>
                    </div>

                    <form class="comment-form" id="comment-form">
                        <div class="comment-fields">
                            <label>
                                Nombre
                                <input type="text" name="name" maxlength="100" autocomplete="name" required>
                            </label>
                            <label>
                                Email <small>Opcional, nunca se publica</small>
                                <input type="email" name="email" maxlength="254" autocomplete="email">
                            </label>
                        </div>
                        <label>
                            Comentario
                            <textarea name="text" rows="5" maxlength="10000" aria-describedby="comment-markdown-help" required></textarea>
                        </label>
                        <div class="comment-form-footer">
                            <span id="comment-markdown-help">Admite Markdown y bloques de código.</span>
                            <button type="submit">Publicar</button>
                        </div>
                        <p class="comment-form-message" role="alert"></p>
                    </form>

                    <div id="comments-status" class="comments-status" role="status" aria-live="polite">Cargando comentarios...</div>
                    <div id="comments-list" class="comments-list"></div>
                </section>
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content container">
                <p>GoPress es software libre construido por la comunidad.</p>
                <nav class="footer-links" aria-label="Enlaces del proyecto">
                    <a href="https://github.com/fulldump/gopress">GitHub</a>
                    <a href="https://www.twitch.tv/fulldump">Twitch</a>
                    <a href="https://www.youtube.com/@fulldump">YouTube</a>
                </nav>
            </div>
        </footer>
    </div>
    <script src="/public.js?v=2" defer></script>
    <script src="/comments.js?v=2" defer></script>
    <script src="/article-feedback.js?v=1" defer></script>
</body>
</html>
